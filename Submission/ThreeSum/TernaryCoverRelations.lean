import Mathlib.LinearAlgebra.Dimension.StrongRankCondition
import Mathlib.LinearAlgebra.Dimension.Constructions
import Mathlib.LinearAlgebra.FiniteDimensional.Basic
import Mathlib.LinearAlgebra.Dual.Lemmas
import Mathlib.LinearAlgebra.Matrix.Dual
import Mathlib.Data.Fintype.BigOperators
import Mathlib.Data.Finset.Card
import Mathlib.Tactic

/-!
# A field-independent finite alphabet bound on relation systems

A matrix with `d` rows and entries in the trinary alphabet has its column
span generated by at most `d` of its actual columns.  Padding that basis with
zero columns represents the span by a `d × d` trit matrix.  Consequently the
number of possible column spans is at most `3^(d*d)`, independently of the
field size and of the number of original columns.  This is a count of actual
linear relation systems, not an enumeration of arbitrary field coefficients.
-/

noncomputable section
namespace ThreeSum.TernaryCoverRelations

open Finset

variable {K : Type*} [Field K]

def digitVector {d : ℕ} (v : Fin d → Fin 3) : Fin d → K :=
  fun i => ((v i).val : K)

def spanCode (d : ℕ) (v : Fin d → Fin d → Fin 3) : Submodule K (Fin d → K) :=
  Submodule.span K (Set.range fun j => digitVector (v j))

def possibleSpans (K : Type*) [Field K] (d : ℕ) : Finset (Submodule K (Fin d → K)) := by
  classical
  exact (univ : Finset (Fin d → Fin d → Fin 3)).image (spanCode d)

theorem possibleSpans_card (d : ℕ) : (possibleSpans K d).card ≤ 3 ^ (d * d) := by
  classical
  have h := Finset.card_image_le (f := spanCode (K := K) d)
    (s := (univ : Finset (Fin d → Fin d → Fin 3)))
  simpa [possibleSpans, Fintype.card_fun, pow_mul] using h

/-- Every actual trinary-column span appears in the finite list above. -/
theorem span_mem_possibleSpans {d : ℕ} {σ : Type*} (columns : σ → Fin d → Fin 3) :
    Submodule.span K (Set.range fun j => digitVector (K := K) (columns j)) ∈
      possibleSpans K d := by
  classical
  let S := Submodule.span K (Set.range fun j => digitVector (K := K) (columns j))
  let r := Module.finrank K S
  have hr : r ≤ d := by
    have h := Submodule.finrank_le S
    simpa [r, Module.finrank_fintype_fun_eq_card] using h
  obtain ⟨f, hf, hspan, _⟩ := Submodule.exists_fun_fin_finrank_span_eq K
    (Set.range fun j => digitVector (K := K) (columns j))
  have hspanS : Submodule.span K (Set.range f) = S := hspan
  let chosen : Fin r → Fin d → Fin 3 := fun i => columns (Classical.choose (hf i))
  have hchosen (i : Fin r) : digitVector (K := K) (chosen i) = f i :=
    Classical.choose_spec (hf i)
  let code : Fin d → Fin d → Fin 3 := fun i =>
    if hi : i.val < r then chosen ⟨i.val, hi⟩ else fun _ => 0
  have hcode : spanCode (K := K) d code = S := by
    apply le_antisymm
    · apply Submodule.span_le.mpr
      rintro v ⟨i, rfl⟩
      dsimp [code]
      split_ifs with hi
      · rw [hchosen]
        rw [← hspanS]
        exact Submodule.subset_span (Set.mem_range_self _)
      · have hz : digitVector (K := K) (fun _ : Fin d => (0 : Fin 3)) = 0 := by
          funext i
          simp [digitVector]
        rw [hz]
        exact S.zero_mem
    · rw [← hspanS]
      apply Submodule.span_le.mpr
      rintro v ⟨i, rfl⟩
      let j : Fin d := ⟨i.val, lt_of_lt_of_le i.isLt hr⟩
      have heq : digitVector (K := K) (code j) = f i := by
        have hi : i.val < r := i.isLt
        simp only [code, j, dif_pos hi]
        exact hchosen i
      rw [← heq]
      exact Submodule.subset_span (Set.mem_range_self j)
  apply mem_image.mpr
  exact ⟨code, mem_univ _, hcode⟩

/-- For `2k` paired rows, the number of actual relation spans has the
subquadratic-in-the-parameter exponent used in the high moment audit. -/
theorem paired_possibleSpans_card (k : ℕ) :
    (possibleSpans K (2 * k)).card ≤ 3 ^ (4 * k ^ 2) := by
  convert possibleSpans_card (K := K) (2 * k) using 1 <;> ring

/-- A coefficient row is a relation exactly when it annihilates the
column span.  The dot-product equivalence identifies coefficients with the
ordinary linear dual; no positive-definiteness assumption is used. -/
def relationSpace {d : ℕ} (S : Submodule K (Fin d → K)) : Submodule K (Fin d → K) :=
  S.dualAnnihilator.comap (dotProductEquiv K (Fin d)).toLinearMap

theorem mem_relationSpace_span {d : ℕ} {σ : Type*}
    (columns : σ → Fin d → Fin 3) (a : Fin d → K) :
    a ∈ relationSpace (Submodule.span K (Set.range fun j => digitVector (K := K) (columns j))) ↔
      ∀ j : σ, ∑ i, a i * digitVector (K := K) (columns j) i = 0 := by
  classical
  change dotProductEquiv K (Fin d) a ∈
    (Submodule.span K (Set.range fun j => digitVector (K := K) (columns j))).dualAnnihilator ↔ _
  rw [Submodule.mem_dualAnnihilator]
  constructor
  · intro h j
    exact h _ (Submodule.subset_span (Set.mem_range_self j))
  · intro h v hv
    have hs : Submodule.span K (Set.range fun j => digitVector (K := K) (columns j)) ≤
        LinearMap.ker (dotProductEquiv K (Fin d) a) := by
      apply Submodule.span_le.mpr
      rintro w ⟨j, rfl⟩
      exact h j
    exact hs hv

def possibleRelations (K : Type*) [Field K] (d : ℕ) : Finset (Submodule K (Fin d → K)) := by
  classical
  exact (possibleSpans K d).image relationSpace

theorem possibleRelations_card (d : ℕ) :
    (possibleRelations K d).card ≤ 3 ^ (d * d) := by
  classical
  exact (Finset.card_image_le).trans (possibleSpans_card d)

theorem actual_relation_mem {d : ℕ} {σ : Type*} (columns : σ → Fin d → Fin 3) :
    relationSpace (Submodule.span K (Set.range fun j => digitVector (K := K) (columns j))) ∈
      possibleRelations K d := by
  classical
  exact mem_image.mpr ⟨_, span_mem_possibleSpans columns, rfl⟩

end ThreeSum.TernaryCoverRelations
